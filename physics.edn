;; What this vertical's robot physically does, declared for
;; kotoba.robotics.process (kotoba-lang/robotics). `kbb -M:dev:physics` runs it.
;;
;; README "Robotics premise": a robot may perform the physical work of a
;; clothing / footwear / leather-goods store (ISIC 4771) -- garment and
;; footwear shelfing, fitting-room support, restocking. Here: an arm putting
;; a stack of shoe boxes on the stockroom shelf, and a rolling garment rack
;; (hanging stock, high centre of gravity) moved from the fitting rooms back
;; to the floor.
;;
;; Every number without a cited source is marked `estimate` in its :basis.
;; Replacing an estimate with a sourced value is this bot's growth work.
{:physics/schema "itonami.physical-ai.spec.v1"
 :repo "cloud-itonami/cloud-itonami-isic-4771"
 :cases
 [{:id :shoe-box-stack-to-shelf
   :kind :manipulator
   :procedure "arm lifts a stack of shoe boxes from the stockroom cart onto the upper shelf"
   :params {:l1-m 0.55 :l2-m 0.50 :m1-kg 4.5 :m2-kg 3.0
            :from [0.60 0.30] :to [0.30 0.90] :duration-s 2.5 :steps 500}
   :sweep {:param :payload-kg :values [1.0 2.5 4.0 6.0 8.0]}
   :quantity :peak-tau1-nm
   :limit {:max 70.0 :basis "estimate: continuous shoulder torque of a ~5 kg-payload collaborative arm; one boxed pair of shoes is ~1-1.5 kg"}
   :boundary {:lo 0.2 :hi 30.0}}
  {:id :garment-rack-return-stop
   :kind :transport
   :procedure "robot pushes a rolling Z-rack of hanging garments from the fitting rooms back to the floor and brakes for a shopper"
   :params {:mass-kg 25.0 :payload-kg 50.0 :distance-m 30.0 :v-max-mps 0.8 :a-max-mps2 0.4
            :drive-force-n 150.0 :crr 0.02 :cog-height-m 0.50 :payload-cog-height-m 1.20
            :support-half-length-m 0.35 :max-time-s 600.0}
   :sweep {:param :brake-decel-mps2 :values [0.5 1.0 2.0 3.0 4.0]}
   :quantity :min-tipover-margin
   :limit {:min 0.25 :basis "estimate: keep a 25 % stability reserve for a garment rack whose hanging load sits ~1.2 m up"}
   :boundary {:lo 0.3 :hi 6.0}}]}
